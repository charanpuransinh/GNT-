{
  "module": "M11",
  "name": "Payment Processing Flow",
  "steps": [
    {"step": 1, "from": "frontend/PaymentEntryPage", "to": "backend/payment.controller", "action": "POST /payments"},
    {"step": 2, "from": "backend/payment.controller", "to": "backend/payment.service", "action": "recordPayment()"},
    {"step": 3, "from": "backend/payment.service", "to": "M10/accounting.service", "action": "POST /public/m10/journal-entry"},
    {"step": 4, "from": "backend/payment.service", "to": "M06/party.service", "action": "GET /public/m06/party/{id}"},
    {"step": 5, "from": "backend/payment.service", "to": "event.bus", "action": "publish payment.completed"},
    {"step": 6, "from": "event.bus", "to": "M13/automation.handlers", "action": "trigger rules"}
  ]
}