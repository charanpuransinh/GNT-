{
  "module": "M12",
  "name": "Payroll Processing Flow",
  "steps": [
    {"step": 1, "from": "frontend/PayrollPage", "to": "backend/payroll.controller", "action": "POST /payroll/generate"},
    {"step": 2, "from": "backend/payroll.controller", "to": "backend/payroll.service", "action": "generatePayroll()"},
    {"step": 3, "from": "backend/payroll.service", "to": "M11/payment.service", "action": "POST /public/m11/record-payment"},
    {"step": 4, "from": "backend/payroll.service", "to": "M13/automation.service", "action": "POST /public/m13/publish-event"},
    {"step": 5, "from": "backend/payroll.service", "to": "event.bus", "action": "publish payroll.paid"}
  ]
}