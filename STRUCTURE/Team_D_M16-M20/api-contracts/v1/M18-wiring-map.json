{
  "module": "M18",
  "name": "External Integration",
  "owner": "D4-DELTA",
  "version": "2.0",
  "provides": {
    "gateway.service.ts": {
      "sendWhatsApp": {
        "consumer": "M16",
        "method": "sendWhatsApp(phone, message)",
        "channel": "notification",
        "description": "M16 notification channel for WhatsApp"
      },
      "sendSMS": {
        "consumer": "M16",
        "method": "sendSMS(phone, message)",
        "channel": "notification",
        "description": "M16 notification channel for SMS"
      },
      "processPayment": {
        "consumer": "M11",
        "method": "processPayment(payload)",
        "channel": "payment",
        "description": "M11 payment gateway connector"
      },
      "verifyGSTN": {
        "consumer": "M09",
        "method": "verifyGSTN(gstin)",
        "channel": "compliance",
        "description": "M09 GST compliance verification"
      },
      "receiveWebhook": {
        "consumer": "Internal",
        "method": "receiveWebhook(provider, payload)",
        "channel": "event_dispatch",
        "description": "Internal event dispatch from webhooks"
      }
    },
    "integration.service.ts": {
      "getGatewayStatus": {
        "consumer": "Frontend",
        "method": "getGatewayStatus(type)",
        "channel": "status_page",
        "description": "Frontend status page data"
      },
      "generateAPIKey": {
        "consumer": "Frontend",
        "method": "generateAPIKey(permissions)",
        "channel": "api_key_manager",
        "description": "API key manager"
      }
    }
  },
  "consumes": {
    "external": [
      {
        "system": "WhatsApp Business API",
        "purpose": "Send WhatsApp messages",
        "protocol": "HTTPS/REST",
        "auth": "Bearer Token"
      },
      {
        "system": "SMS Gateway (Twilio/Msg91/etc)",
        "purpose": "Send SMS",
        "protocol": "HTTPS/REST",
        "auth": "API Key / Basic Auth"
      },
      {
        "system": "Payment Gateway (Razorpay/Stripe/etc)",
        "purpose": "Process payments",
        "protocol": "HTTPS/REST",
        "auth": "API Key / Basic Auth"
      },
      {
        "system": "GSTN Portal",
        "purpose": "GST verification",
        "protocol": "HTTPS/REST",
        "auth": "Bearer Token"
      },
      {
        "system": "E-Invoice IRP",
        "purpose": "E-invoice generation",
        "protocol": "HTTPS/REST",
        "auth": "API Key"
      },
      {
        "system": "E-Way Bill Portal",
        "purpose": "E-way bill generation",
        "protocol": "HTTPS/REST",
        "auth": "API Key"
      }
    ]
  },
  "events": {
    "published": [
      {
        "event": "webhook.received",
        "consumers": ["Internal handlers"],
        "description": "Async webhook processing"
      },
      {
        "event": "gateway.status.changed",
        "consumers": ["M19 monitoring"],
        "description": "Gateway health monitoring"
      },
      {
        "event": "payment.webhook.success",
        "consumers": ["M11 payment confirmation"],
        "description": "Payment success notification"
      },
      {
        "event": "payment.webhook.failed",
        "consumers": ["M16 alert notification"],
        "description": "Payment failure alert"
      }
    ]
  },
  "hard_boundaries": {
    "legal": [
      "M16 → M18 gateway.service.sendWhatsApp()",
      "M11 → M18 gateway.service.processPayment()",
      "External webhook → M18 webhook.controller"
    ],
    "illegal": [
      "External system → M18 integration.repository.ts",
      "M18 → Direct business logic / financial posting",
      "M18 → Modifying M09 GST data directly"
    ]
  },
  "database_ownership": {
    "integration_config": "M18",
    "api_key_registry": "M18",
    "webhook_log": "M18"
  }
}
