// M13 AUTOMATION MODULE — PRISMA SCHEMA

model Workflow {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT)
  triggerType   TriggerType @map("trigger_type")
  triggerConfig Json?    @map("trigger_config")
  steps         Json
  variables     Json?
  metadata      Json?
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  executions    WorkflowExecution[]
  triggers      WorkflowTrigger[]
  schedules     ScheduledJob[]
  @@index([tenantId, status])
  @@index([tenantId, triggerType])
  @@map("m13_workflows")
}

model WorkflowTrigger {
  id            String   @id @default(cuid())
  workflowId    String   @map("workflow_id")
  workflow      Workflow @relation(fields: [workflowId], references: [id])
  triggerType   TriggerType @map("trigger_type")
  config        Json
  isActive      Boolean  @default(true) @map("is_active")
  lastFiredAt   DateTime? @map("last_fired_at")
  fireCount     Int      @default(0) @map("fire_count")
  tenantId      String   @map("tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([tenantId, triggerType, isActive])
  @@index([workflowId])
  @@map("m13_workflow_triggers")
}

model WorkflowExecution {
  id            String   @id @default(cuid())
  workflowId    String   @map("workflow_id")
  workflow      Workflow @relation(fields: [workflowId], references: [id])
  status        ExecutionStatus @default(PENDING)
  triggerSource String   @map("trigger_source")
  triggerData   Json?    @map("trigger_data")
  context       Json
  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  durationMs    Int?     @map("duration_ms")
  errorMessage  String?  @map("error_message")
  tenantId      String   @map("tenant_id")
  createdBy     String?  @map("created_by")
  steps         WorkflowStepExecution[]
  logs          AutomationLog[]
  @@index([tenantId, workflowId, status])
  @@index([tenantId, startedAt])
  @@map("m13_workflow_executions")
}

model WorkflowStepExecution {
  id            String   @id @default(cuid())
  executionId   String   @map("execution_id")
  execution     WorkflowExecution @relation(fields: [executionId], references: [id])
  stepId        String   @map("step_id")
  stepType      String   @map("step_type")
  stepName      String   @map("step_name")
  status        StepStatus @default(PENDING)
  inputData     Json?    @map("input_data")
  outputData    Json?    @map("output_data")
  errorDetails  Json?    @map("error_details")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  retryCount    Int      @default(0) @map("retry_count")
  tenantId      String   @map("tenant_id")
  @@index([executionId, status])
  @@map("m13_workflow_step_executions")
}

model ScheduledJob {
  id            String   @id @default(cuid())
  workflowId    String   @map("workflow_id")
  workflow      Workflow @relation(fields: [workflowId], references: [id])
  name          String
  cronExpression String  @map("cron_expression")
  timezone      String   @default("UTC")
  isActive      Boolean  @default(true) @map("is_active")
  nextRunAt     DateTime? @map("next_run_at")
  lastRunAt     DateTime? @map("last_run_at")
  lastRunStatus String?  @map("last_run_status")
  tenantId      String   @map("tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@index([tenantId, isActive, nextRunAt])
  @@map("m13_scheduled_jobs")
}

model AutomationLog {
  id            String   @id @default(cuid())
  executionId   String?  @map("execution_id")
  execution     WorkflowExecution? @relation(fields: [executionId], references: [id])
  level         LogLevel
  message       String
  metadata      Json?
  tenantId      String   @map("tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([tenantId, executionId])
  @@index([tenantId, createdAt])
  @@map("m13_automation_logs")
}

enum WorkflowStatus { DRAFT ACTIVE PAUSED ARCHIVED }
enum TriggerType { MANUAL WEBHOOK SCHEDULE EVENT API }
enum ExecutionStatus { PENDING RUNNING COMPLETED FAILED CANCELLED TIMEOUT }
enum StepStatus { PENDING RUNNING COMPLETED FAILED SKIPPED WAITING }
enum LogLevel { INFO WARN ERROR DEBUG }
