model AuditLog {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  userId        String?  @map("user_id")
  action        String
  module        String
  resource      String
  resourceId    String?  @map("resource_id")
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([module, action])
  @@map("audit_log")
}

model LoginHistory {
  id                String   @id @default(cuid())
  companyId         String   @map("company_id")
  userId            String   @map("user_id")
  ipAddress         String   @map("ip_address")
  deviceFingerprint String?  @map("device_fingerprint")
  location          String?
  status            LoginStatus
  attemptCount      Int      @default(1) @map("attempt_count")
  createdAt         DateTime @default(now()) @map("created_at")
  @@index([companyId, userId, createdAt])
  @@index([ipAddress, status])
  @@map("login_history")
}

enum LoginStatus { success failed }

model SecurityEvent {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  eventType   String    @map("event_type")
  severity    Severity
  description String
  metadata    Json?
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  @@index([companyId, severity, createdAt])
  @@index([eventType, createdAt])
  @@map("security_event")
}

enum Severity { low medium high critical }

model SystemHealth {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  serviceName     String   @map("service_name")
  status          HealthStatus
  responseTimeMs  Int?     @map("response_time_ms")
  lastCheckedAt   DateTime @default(now()) @map("last_checked_at")
  errorCount      Int      @default(0) @map("error_count")
  @@index([companyId, serviceName])
  @@index([status, lastCheckedAt])
  @@map("system_health")
}

enum HealthStatus { healthy degraded unhealthy down }
