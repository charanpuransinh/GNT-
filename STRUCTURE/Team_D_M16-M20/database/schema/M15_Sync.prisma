model SyncConfig {
  id              String   @id @default(cuid())
  configCode      String   @unique // SYNC-TALLY, SYNC-ZOHO
  name            String
  description     String?

  // Source system
  sourceSystem    String   // INTERNAL, TALLY, ZOHO_BOOKS, QUICKBOOKS, SALESFORCE, SHOPIFY
  sourceVersion   String?

  // Direction
  syncDirection   String   // BIDIRECTIONAL, TO_EXTERNAL, FROM_EXTERNAL

  // Entities to sync
  entityConfigs   SyncEntityConfig[]

  // Connection
  connectionType  String   // API, DATABASE, FILE, WEBHOOK, SFTP
  connectionConfig Json    // {baseUrl, authType, credentials, headers}

  // Schedule
  syncMode        String   @default("MANUAL") // MANUAL, SCHEDULED, REALTIME
  cronExpression  String?

  // Status
  status          String   @default("ACTIVE") // ACTIVE, PAUSED, ERROR, DISABLED

  // Last sync info
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // SUCCESS, PARTIAL, FAILED
  lastSyncJobId   String?

  // Error tracking
  consecutiveErrors Int    @default(0)
  errorThreshold  Int      @default(5) // Auto-pause after N consecutive errors

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@map("m15_sync_configs")
}

model SyncEntityConfig {
  id              String   @id @default(cuid())
  syncConfigId    String
  syncConfig      SyncConfig @relation(fields: [syncConfigId], references: [id], onDelete: Cascade)

  // Entity mapping
  internalEntity  String   // ITEM, CUSTOMER, INVOICE, PAYMENT
  externalEntity  String   // Products, Contacts, Invoices, Payments

  // Field mapping
  fieldMappings   Json[]   // [{internalField, externalField, transform, isKey}]

  // Sync rules
  syncDirection   String   @default("BIDIRECTIONAL") // TO_EXTERNAL, FROM_EXTERNAL, BIDIRECTIONAL

  // Filters
  sourceFilter    Json?    // {activeOnly: true, dateFrom: "2026-01-01"}
  targetFilter    Json?

  // Conflict
  conflictResolution String @default("INTERNAL_WINS") // INTERNAL_WINS, EXTERNAL_WINS, TIMESTAMP_WINS, MANUAL

  // Schedule override
  syncMode        String?  // Override parent config
  cronExpression  String?

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([syncConfigId])
  @@map("m15_sync_entity_configs")
}

model SyncJob {
  id              String   @id @default(cuid())
  jobNumber       String   @unique // SYN-2026-000001

  syncConfigId    String
  syncConfig      SyncConfig @relation(fields: [syncConfigId], references: [id])

  // Trigger
  triggeredBy     String   // USER, SCHEDULE, WEBHOOK, RETRY
  triggeredByUser String?

  // Scope
  entityType      String?  // If single entity sync

  // Status
  status          String   @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED

  // Progress
  totalEntities   Int      @default(0)
  processedEntities Int    @default(0)
  createdCount    Int      @default(0)
  updatedCount    Int      @default(0)
  deletedCount    Int      @default(0)
  skippedCount    Int      @default(0)
  errorCount      Int      @default(0)
  conflictCount   Int      @default(0)

  // Timing
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?

  // Results
  resultSummary   Json?
  errorSummary    Json?

  // Child logs
  entityLogs      SyncEntityLog[]
  conflicts       SyncConflict[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([syncConfigId, status])
  @@index([tenantId, createdAt])
  @@map("m15_sync_jobs")
}

model SyncEntityLog {
  id              String   @id @default(cuid())
  syncJobId       String
  syncJob         SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  entityType      String
  internalId      String?
  externalId      String?

  // Action
  action          String   // CREATE, UPDATE, DELETE, SKIP, CONFLICT
  direction       String   // TO_EXTERNAL, FROM_EXTERNAL

  // Data snapshots
  internalData    Json?
  externalData    Json?

  // Result
  status          String   // SUCCESS, FAILED, CONFLICT
  errorMessage    String?
  errorCode       String?

  // Timing
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?

  tenantId        String

  @@index([syncJobId, entityType])
  @@index([status])
  @@map("m15_sync_entity_logs")
}

model SyncConflict {
  id              String   @id @default(cuid())
  syncJobId       String
  syncJob         SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  entityType      String
  internalId      String
  externalId      String

  // Conflict details
  conflictType    String   // UPDATE_BOTH, DELETE_UPDATE, CREATE_DUPLICATE
  conflictField   String?  // Specific field in conflict

  // Data
  internalValue   Json?
  externalValue   Json?
  internalVersion String?
  externalVersion String?

  // Resolution
  resolution      String?  // INTERNAL_WINS, EXTERNAL_WINS, MERGED, MANUAL
  resolvedBy      String?
  resolvedAt      DateTime?
  mergedValue     Json?

  status          String   @default("PENDING") // PENDING, RESOLVED, AUTO_RESOLVED

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([syncJobId, status])
  @@index([entityType, status])
  @@map("m15_sync_conflicts")
}

model ExternalIntegration {
  id              String   @id @default(cuid())
  integrationCode String   @unique
  name            String
  description     String?

  // Provider
  provider        String   // TALLY, ZOHO, QUICKBOOKS, SALESFORCE, RAZORPAY, GST_PORTAL
  providerVersion String?

  // Auth
  authType        String   // OAUTH2, API_KEY, BASIC, CERTIFICATE
  authConfig      Json     // Encrypted tokens, keys

  // Endpoints
  baseUrl         String?
  apiVersion      String?
  endpoints       Json?    // {auth, refresh, entities}

  // Status
  status          String   @default("ACTIVE")

  // Health
  lastHealthCheck DateTime?
  healthStatus    String?  // HEALTHY, DEGRADED, DOWN

  // Rate limits
  rateLimitConfig Json?    // {requestsPerMinute, burstLimit}

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@map("m15_external_integrations")
}

model SyncState {
  id              String   @id @default(cuid())

  syncConfigId    String
  entityType      String

  // Sync cursor / watermark
  lastSyncAt      DateTime
  lastSyncJobId   String

  // Watermark for incremental sync
  watermark       Json?    // {lastId, lastModified, lastSequence}

  // Entity counts
  totalSynced     Int      @default(0)
  lastBatchSize   Int      @default(0)

  // Checksum for integrity
  checksum        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@unique([syncConfigId, entityType])
  @@map("m15_sync_states")
}
