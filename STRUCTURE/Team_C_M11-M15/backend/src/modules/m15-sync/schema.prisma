// M15 Sync Module — Prisma Schema
// GNT Team C | Modular Monolith Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// M15 SYNC CORE TABLES
// ───────────────────────────────────────────────

model SyncJob {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  source        String   // e.g., "local", "cloud", "external_api"
  target        String   // e.g., "cloud", "local", "external_api"
  syncType      String   @map("sync_type") // "full", "delta", "bidirectional"
  status        String   @default("idle") // "idle", "running", "paused", "failed", "completed"
  lastRunAt     DateTime? @map("last_run_at")
  nextRunAt     DateTime? @map("next_run_at")
  cronExpression String?  @map("cron_expression")
  config        Json?    // { tables: [], filters: {}, mappings: {} }
  metadata      Json?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  syncLogs      SyncLog[]
  syncQueue     SyncQueueItem[]

  @@index([tenantId, status])
  @@index([tenantId, isActive])
  @@map("m15_sync_jobs")
}

model SyncLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  syncJobId   String   @map("sync_job_id")
  syncJob     SyncJob  @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  direction   String   // "push", "pull", "bidirectional"
  status      String   // "success", "failed", "partial"
  recordsProcessed Int @default(0) @map("records_processed")
  recordsFailed    Int @default(0) @map("records_failed")
  startedAt   DateTime @map("started_at")
  completedAt DateTime? @map("completed_at")
  errorMessage String? @map("error_message")
  details     Json?    // { tableStats: {}, conflicts: [] }
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, syncJobId])
  @@index([tenantId, status])
  @@map("m15_sync_logs")
}

model SyncQueueItem {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  syncJobId   String   @map("sync_job_id")
  syncJob     SyncJob  @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  operation   String   // "push", "pull", "resolve"
  entityType  String   @map("entity_type") // "invoice", "employee", "payment", etc.
  entityId    String   @map("entity_id")
  payload     Json     // { data: {}, checksum: "", version: 0 }
  status      String   @default("pending") // "pending", "processing", "completed", "failed", "conflict"
  retryCount  Int      @default(0) @map("retry_count")
  maxRetries  Int      @default(3) @map("max_retries")
  errorMessage String? @map("error_message")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@map("m15_sync_queue")
}

// ───────────────────────────────────────────────
// M15 CONFLICT RESOLUTION
// ───────────────────────────────────────────────

model SyncConflict {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  syncJobId     String   @map("sync_job_id")
  syncLogId     String?  @map("sync_log_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  localVersion  Json     @map("local_version")
  remoteVersion Json     @map("remote_version")
  resolvedVersion Json?  @map("resolved_version")
  resolution    String?  // "local_wins", "remote_wins", "merge", "manual"
  resolvedBy    String?  @map("resolved_by") // userId
  resolvedAt    DateTime? @map("resolved_at")
  status        String   @default("open") // "open", "resolved", "ignored"
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@map("m15_sync_conflicts")
}

// ───────────────────────────────────────────────
// M15 BACKUP & RESTORE
// ───────────────────────────────────────────────

model BackupJob {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  backupType    String   @map("backup_type") // "full", "incremental", "differential"
  status        String   @default("scheduled") // "scheduled", "running", "completed", "failed"
  storageType   String   @map("storage_type") // "local", "s3", "gcs", "azure"
  storagePath   String?  @map("storage_path")
  fileSize      BigInt?  @map("file_size")
  checksum      String?
  tablesIncluded String[] @map("tables_included")
  retentionDays Int      @default(30) @map("retention_days")
  expiresAt     DateTime? @map("expires_at")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  errorMessage  String?  @map("error_message")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  restoreJobs   RestoreJob[]

  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
  @@map("m15_backup_jobs")
}

model RestoreJob {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  backupJobId   String   @map("backup_job_id")
  backupJob     BackupJob @relation(fields: [backupJobId], references: [id], onDelete: Cascade)
  status        String   @default("queued") // "queued", "running", "completed", "failed", "rolled_back"
  tablesRestored String[] @map("tables_restored")
  recordsRestored Int    @default(0) @map("records_restored")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  errorMessage  String?  @map("error_message")
  rolledBackAt  DateTime? @map("rolled_back_at")
  rollbackReason String? @map("rollback_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("m15_restore_jobs")
}

// ───────────────────────────────────────────────
// M15 WEBHOOK INTEGRATION
// ───────────────────────────────────────────────

model WebhookEndpoint {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  url           String
  secret        String   // encrypted webhook secret
  events        String[] // ["sync.completed", "backup.failed", "conflict.created"]
  isActive      Boolean  @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  failureCount  Int      @default(0) @map("failure_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  deliveries    WebhookDelivery[]

  @@index([tenantId, isActive])
  @@map("m15_webhook_endpoints")
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  webhookId       String   @map("webhook_id")
  webhook         WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType       String   @map("event_type")
  payload         Json
  responseStatus  Int?     @map("response_status")
  responseBody    String?  @map("response_body")
  deliveryStatus  String   @map("delivery_status") // "delivered", "failed", "retrying"
  retryCount      Int      @default(0) @map("retry_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, webhookId])
  @@index([tenantId, deliveryStatus])
  @@map("m15_webhook_deliveries")
}

// ───────────────────────────────────────────────
// M15 SYNC STATE / CHANGE TRACKING
// ───────────────────────────────────────────────

model SyncState {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  lastSyncedAt  DateTime @map("last_synced_at")
  checksum      String   // SHA-256 of serialized data
  version       Int      @default(1)
  source        String   // "local", "remote"
  isDeleted     Boolean  @default(false) @map("is_deleted")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, entityType, entityId, source])
  @@index([tenantId, entityType])
  @@index([tenantId, lastSyncedAt])
  @@map("m15_sync_state")
}
