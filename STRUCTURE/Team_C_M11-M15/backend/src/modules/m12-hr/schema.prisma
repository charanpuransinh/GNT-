// [LOCK-1] M12 Prisma Schema
model Employee {
  id            String   @id @default(uuid())
  employeeCode  String   @unique
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  dateOfBirth   DateTime?
  gender        Gender?
  address       String?
  city          String?
  country       String?
  postalCode    String?
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  designation   String
  employmentType EmploymentType @default(FULL_TIME)
  joinDate      DateTime
  exitDate      DateTime?
  status        EmployeeStatus @default(ACTIVE)
  salary        Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  documents     EmployeeDocument[]
  attendance    Attendance[]
  leaves        Leave[]
  payrolls      Payroll[]
  performanceReviews PerformanceReview[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([departmentId])
  @@index([status])
  @@index([employeeCode])
  @@map("employees")
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         DocumentType
  name         String
  url          String
  issuedDate   DateTime?
  expiryDate   DateTime?
  createdAt    DateTime @default(now())
  @@map("employee_documents")
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique
  description String?
  managerId   String?    @unique
  budget      Decimal?   @db.Decimal(12, 2)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@map("departments")
}

model Attendance {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  status       AttendanceStatus @default(PRESENT)
  workHours    Float?
  overtimeHours Float?
  location     String?
  notes        String?
  approvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

model Leave {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         LeaveType
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  days         Float
  reason       String
  status       LeaveStatus @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  rejectionReason String?
  attachmentUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([employeeId, status])
  @@map("leaves")
}

model LeaveBalance {
  id           String   @id @default(uuid())
  employeeId   String
  year         Int
  annual       Float    @default(0)
  sick         Float    @default(0)
  casual       Float    @default(0)
  unpaid       Float    @default(0)
  carriedOver  Float    @default(0)
  used         Float    @default(0)
  updatedAt    DateTime @updatedAt
  @@unique([employeeId, year])
  @@map("leave_balances")
}

model Payroll {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  baseSalary   Decimal  @db.Decimal(12, 2)
  allowances   Decimal  @default(0) @db.Decimal(12, 2)
  deductions   Decimal  @default(0) @db.Decimal(12, 2)
  tax          Decimal  @default(0) @db.Decimal(12, 2)
  netSalary    Decimal  @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  paymentDate  DateTime?
  paymentRef   String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([employeeId, month, year])
  @@map("payrolls")
}

model PerformanceReview {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewPeriod String
  goals        Json?
  achievements Json?
  rating       Float?
  feedback     String?
  status       ReviewStatus @default(DRAFT)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("performance_reviews")
}

enum Gender { MALE FEMALE OTHER }
enum EmploymentType { FULL_TIME PART_TIME CONTRACT INTERNSHIP }
enum EmployeeStatus { ACTIVE INACTIVE ON_LEAVE TERMINATED SUSPENDED }
enum DocumentType { ID PROOF CONTRACT CERTIFICATE MEDICAL OTHER }
enum AttendanceStatus { PRESENT ABSENT LATE HALF_DAY ON_LEAVE HOLIDAY }
enum LeaveType { ANNUAL SICK CASUAL UNPAID MATERNITY PATERNITY EMERGENCY }
enum LeaveStatus { PENDING APPROVED REJECTED CANCELLED }
enum PaymentStatus { PENDING PROCESSED FAILED HOLD }
enum ReviewStatus { DRAFT SUBMITTED COMPLETED }

model HrEventLog {
  id          String   @id @default(uuid())
  eventType   String
  payload     Json
  module      String   @default("M12")
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@map("hr_event_log")
}
