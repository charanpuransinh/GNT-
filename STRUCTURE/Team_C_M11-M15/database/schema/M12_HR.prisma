// ============================================================
// GNT MASTER BLUEPRINT V2 — M12 HR MODULE
// Module Owner: TEAM C | Session 2: Database Schema
// Lock Artifact: M12_DB_SCHEMA_v2.0.0
// Cross-Module Rule: NO direct DB access. Use PUBLIC APIs only.
// NOTE: Payroll payments call M11 Payment PUBLIC API.
// ============================================================

model Employee {
  id              String   @id @default(cuid())
  employeeCode    String   @unique // EMP-2026-0001

  // Personal
  firstName       String
  lastName        String
  email           String
  phone           String?
  alternatePhone  String?
  dateOfBirth     DateTime?
  gender          String?  // MALE, FEMALE, OTHER, PREFER_NOT_TO_SAY
  bloodGroup      String?

  // Identity
  panNumber       String?
  aadhaarNumber   String?  // Encrypted at application layer
  uanNumber       String?  // Universal Account Number (PF)
  esicNumber      String?

  // Employment
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  designationId   String
  designation     Designation @relation(fields: [designationId], references: [id])

  employmentType  String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  employmentStatus String  @default("ACTIVE") // ACTIVE, PROBATION, NOTICE_PERIOD, RESIGNED, TERMINATED

  dateOfJoining   DateTime
  dateOfExit      DateTime?

  // Reporting
  reportingToId   String?
  reportingTo     Employee? @relation("EmployeeReporting", fields: [reportingToId], references: [id])
  subordinates    Employee[] @relation("EmployeeReporting")

  // Compensation (monthly)
  basicSalary     Decimal  @db.Decimal(18, 4)
  salaryStructure Json?    // Breakdown: HRA, DA, TA, etc.

  // Bank
  bankAccountName String?
  bankAccountNo   String?  // Encrypted
  bankIfsc        String?
  bankName        String?

  // Work
  shiftId         String?
  shift           Shift?   @relation(fields: [shiftId], references: [id])
  workLocation    String?

  // Documents
  documents       EmployeeDocument[]

  // Relations
  attendances     Attendance[]
  leaves          Leave[]
  payrolls        Payroll[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@index([tenantId, employmentStatus])
  @@index([departmentId])
  @@index([reportingToId])
  @@map("m12_employees")
}

model Department {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?

  parentId        String?
  parent          Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children        Department[] @relation("DeptHierarchy")

  costCenterCode  String?  // Links to M10 Finance
  isActive        Boolean  @default(true)

  employees       Employee[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_departments")
}

model Designation {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  level           Int      @default(1) // 1=Junior, 5=Executive
  description     String?
  isActive        Boolean  @default(true)

  employees       Employee[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_designations")
}

model EmployeeDocument {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  documentType    String   // RESUME, OFFER_LETTER, AADHAAR, PAN, CONTRACT, EXPERIENCE
  documentName    String
  fileUrl         String
  fileKey         String   // S3/Storage key
  mimeType        String
  fileSize        Int

  expiryDate      DateTime?
  isVerified      Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([employeeId])
  @@map("m12_employee_documents")
}

model Shift {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String

  startTime       String   // "09:00"
  endTime         String   // "18:00"
  breakDuration   Int      @default(60) // minutes

  workingDays     String[] // ["MON","TUE","WED","THU","FRI"]

  gracePeriod     Int      @default(15) // minutes
  halfDayAfter    Int      @default(240) // minutes after start

  isNightShift    Boolean  @default(false)
  isActive        Boolean  @default(true)

  employees       Employee[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_shifts")
}

model Attendance {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date

  // Punch times
  checkIn         DateTime?
  checkOut        DateTime?

  // Geo
  checkInLocation Json?    // {lat, lng, address}
  checkOutLocation Json?

  // Device
  checkInDevice   String?  // WEB, MOBILE, BIOMETRIC, MANUAL
  checkOutDevice  String?

  // Calculated
  totalHours      Decimal? @db.Decimal(4, 2)
  breakHours      Decimal? @db.Decimal(4, 2)
  workingHours    Decimal? @db.Decimal(4, 2)
  overtimeHours   Decimal? @db.Decimal(4, 2)

  // Status
  status          String   @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, ON_LEAVE, WFH, HOLIDAY, WEEKLY_OFF
  lateByMinutes   Int      @default(0)
  earlyExitMinutes Int     @default(0)

  // Remarks
  remarks         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId, status])
  @@map("m12_attendance")
}

model LeaveType {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?

  // Entitlement
  annualQuota     Decimal  @db.Decimal(5, 2) // days per year
  maxCarryForward Decimal  @default(0) @db.Decimal(5, 2)
  encashable      Boolean  @default(false)

  // Rules
  minDaysPerRequest Int    @default(1)
  maxDaysPerRequest Int?
  noticeDaysRequired Int   @default(0)

  // Pay rules
  isPaid          Boolean  @default(true)
  payPercentage   Decimal  @default(100) @db.Decimal(5, 2)

  isActive        Boolean  @default(true)

  leaves          Leave[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_leave_types")
}

model Leave {
  id              String   @id @default(cuid())
  leaveNumber     String   @unique // LEV-2026-0001

  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])

  // Dates
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  daysRequested   Decimal  @db.Decimal(5, 2)
  daysApproved    Decimal? @db.Decimal(5, 2)

  // Reason
  reason          String
  attachmentUrl   String?

  // Workflow
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  // Half-day support
  isHalfDay       Boolean  @default(false)
  halfDayType     String?  // FIRST_HALF, SECOND_HALF

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@index([employeeId, status])
  @@index([tenantId, startDate])
  @@map("m12_leaves")
}

model Holiday {
  id              String   @id @default(cuid())
  name            String
  date            DateTime @db.Date
  holidayType     String   @default("PUBLIC") // PUBLIC, RESTRICTED, COMPANY
  description     String?
  isRecurring     Boolean  @default(false)

  createdAt       DateTime @default(now())
  tenantId        String

  @@unique([tenantId, date, name])
  @@map("m12_holidays")
}

model Payroll {
  id              String   @id @default(cuid())
  payrollNumber   String   @unique // PAY-2026-04-0001

  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Period
  month           Int      // 1-12
  year            Int
  periodStart     DateTime
  periodEnd       DateTime

  // Attendance summary (denormalized for performance)
  daysWorked      Decimal  @db.Decimal(5, 2)
  daysLeave       Decimal  @db.Decimal(5, 2)
  daysAbsent      Decimal  @db.Decimal(5, 2)
  daysHoliday     Decimal  @db.Decimal(5, 2)
  overtimeHours   Decimal  @default(0) @db.Decimal(5, 2)

  // Earnings
  basicSalary     Decimal  @db.Decimal(18, 4)
  hra             Decimal  @default(0) @db.Decimal(18, 4)
  da              Decimal  @default(0) @db.Decimal(18, 4)
  conveyance      Decimal  @default(0) @db.Decimal(18, 4)
  medical         Decimal  @default(0) @db.Decimal(18, 4)
  specialAllowance Decimal @default(0) @db.Decimal(18, 4)
  overtimePay     Decimal  @default(0) @db.Decimal(18, 4)
  bonus           Decimal  @default(0) @db.Decimal(18, 4)
  otherEarnings   Decimal  @default(0) @db.Decimal(18, 4)
  totalEarnings   Decimal  @db.Decimal(18, 4)

  // Deductions
  pfEmployee      Decimal  @default(0) @db.Decimal(18, 4)
  pfEmployer      Decimal  @default(0) @db.Decimal(18, 4)
  esiEmployee     Decimal  @default(0) @db.Decimal(18, 4)
  esiEmployer     Decimal  @default(0) @db.Decimal(18, 4)
  tds             Decimal  @default(0) @db.Decimal(18, 4)
  professionalTax Decimal  @default(0) @db.Decimal(18, 4)
  advanceRecovery Decimal  @default(0) @db.Decimal(18, 4)
  otherDeductions Decimal  @default(0) @db.Decimal(18, 4)
  totalDeductions Decimal  @db.Decimal(18, 4)

  // Net
  netPay          Decimal  @db.Decimal(18, 4)

  // Status
  status          String   @default("DRAFT") // DRAFT, REVIEWED, APPROVED, PAID

  // Payment linkage (M11 Payment PUBLIC API)
  paymentTransactionId String?
  paidAt          DateTime?
  paidBy          String?

  // Payslip
  payslipGeneratedAt DateTime?
  payslipUrl      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@unique([employeeId, month, year])
  @@index([tenantId, month, year])
  @@index([status])
  @@map("m12_payrolls")
}

model PayrollTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?

  // Components
  components      Json[]   // [{type: EARNING|DEDUCTION, name, formula, isMandatory}]

  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_payroll_templates")
}
