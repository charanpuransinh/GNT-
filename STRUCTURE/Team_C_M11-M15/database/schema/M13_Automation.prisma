model Workflow {
  id              String   @id @default(cuid())
  workflowCode    String   @unique // WF-INV-APPROVAL
  name            String
  description     String?

  // Target module/entity this workflow automates
  entityType      String   // INVOICE, PURCHASE_ORDER, LEAVE, EXPENSE, JOURNAL, CUSTOM
  entityModule    String   // M07, M08, M12, etc.

  // Trigger config
  triggerType     String   // MANUAL, EVENT, SCHEDULE, WEBHOOK
  triggerConfig   Json?    // {event: "INVOICE_CREATED", schedule: "0 9 * * *"}

  // Status
  status          String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  version         Int      @default(1)

  // Steps
  steps           WorkflowStep[]
  executions      WorkflowExecution[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  tenantId        String

  @@index([tenantId, entityType])
  @@index([status])
  @@map("m13_workflows")
}

model WorkflowStep {
  id              String   @id @default(cuid())
  workflowId      String
  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  stepNumber      Int
  name            String
  description     String?

  // Step type
  stepType        String   // CONDITION, ACTION, APPROVAL, NOTIFICATION, DELAY, WEBHOOK, SUB_WORKFLOW

  // Config based on type
  config          Json     // Action: {actionType, params}, Condition: {field, operator, value}

  // For approval steps
  approverType    String?  // ROLE, USER, MANAGER, DEPARTMENT_HEAD
  approverIds     String[] // User IDs if specific users
  approvalType    String?  // ANY, ALL, SEQUENTIAL
  escalationAfterMinutes Int?

  // Branching
  onSuccessStepId String?
  onFailureStepId String?

  // UI
  positionX       Int      @default(0)
  positionY       Int      @default(0)

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([workflowId, stepNumber])
  @@map("m13_workflow_steps")
}

model WorkflowExecution {
  id              String   @id @default(cuid())
  executionNumber String   @unique // WFE-2026-000001

  workflowId      String
  workflow        Workflow @relation(fields: [workflowId], references: [id])

  // Context
  entityType      String
  entityId        String
  entityData      Json?    // Snapshot of entity at execution time

  // Status
  status          String   @default("RUNNING") // RUNNING, COMPLETED, FAILED, CANCELLED, WAITING
  currentStepId   String?

  // Timing
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  // Results
  resultData      Json?
  errorMessage    String?

  // Steps executed
  stepLogs        WorkflowStepLog[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([workflowId, status])
  @@index([entityType, entityId])
  @@map("m13_workflow_executions")
}

model WorkflowStepLog {
  id              String   @id @default(cuid())
  executionId     String
  execution       WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  stepId          String
  stepName        String
  stepType        String

  // Execution
  status          String   // PENDING, IN_PROGRESS, COMPLETED, FAILED, SKIPPED
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  // Input/Output
  inputData       Json?
  outputData      Json?
  errorDetails    Json?

  // For approval steps
  actedBy         String?
  actedAt         DateTime?
  action          String?  // APPROVED, REJECTED
  comments        String?

  tenantId        String

  @@index([executionId])
  @@map("m13_workflow_step_logs")
}

model ScheduledJob {
  id              String   @id @default(cuid())
  jobCode         String   @unique
  name            String
  description     String?

  // Schedule
  cronExpression  String   // "0 2 * * *"
  timezone        String   @default("Asia/Kolkata")

  // Action
  actionType      String   // WORKFLOW, API_CALL, REPORT, BACKUP, SYNC, CUSTOM_SCRIPT
  actionConfig    Json     // {workflowId, apiEndpoint, method, payload}

  // Target module (for cross-module calls via PUBLIC API)
  targetModule    String?
  targetEndpoint  String?

  // Status
  status          String   @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED

  // Execution tracking
  lastRunAt       DateTime?
  lastRunStatus   String?  // SUCCESS, FAILED
  lastRunResult   Json?
  nextRunAt       DateTime?

  runCount        Int      @default(0)
  failureCount    Int      @default(0)

  // Notifications
  notifyOnFailure String[] // email addresses
  notifyOnSuccess String[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@map("m13_scheduled_jobs")
}

model AutomationRule {
  id              String   @id @default(cuid())
  ruleCode        String   @unique
  name            String
  description     String?

  // When
  eventType       String   // INVOICE_OVERDUE, STOCK_LOW, LEAVE_APPLIED, PAYMENT_RECEIVED
  sourceModule    String   // M07, M08, M11, M12

  // Condition
  conditions      Json[]   // [{field, operator, value, connector: AND|OR}]

  // Then
  actions         Json[]   // [{actionType, params}]

  // Action types: SEND_EMAIL, SEND_SMS, CREATE_TASK, UPDATE_FIELD, CALL_API, NOTIFY_USER

  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  priority        Int      @default(5) // 1-10

  // Execution limits
  maxExecutions   Int?     // null = unlimited
  executionCount  Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@index([tenantId, eventType])
  @@index([status])
  @@map("m13_automation_rules")
}

model AutomationLog {
  id              String   @id @default(cuid())
  ruleId          String?
  workflowId      String?

  eventType       String
  sourceModule    String
  sourceEntityId  String?

  // Evaluation
  conditionsMet   Boolean
  conditionDetails Json?

  // Actions executed
  actionsTaken    Json[]   // [{actionType, status, result, error}]

  status          String   // SUCCESS, PARTIAL, FAILED
  errorMessage    String?

  executionTimeMs Int
  createdAt       DateTime @default(now())
  tenantId        String

  @@index([tenantId, eventType])
  @@index([createdAt])
  @@map("m13_automation_logs")
}

model WebhookEndpoint {
  id              String   @id @default(cuid())
  name            String
  endpointUrl     String

  // Security
  secretKey       String?  // For HMAC signature
  authType        String   @default("NONE") // NONE, BASIC, BEARER, HMAC
  authConfig      Json?

  // Events subscribed
  eventTypes      String[] // ["INVOICE.CREATED", "PAYMENT.COMPLETED"]

  // Status
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE

  // Delivery tracking
  lastDeliveredAt DateTime?
  lastDeliveryStatus String?
  failureCount    Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@map("m13_webhook_endpoints")
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  endpointId      String

  eventType       String
  payload         Json

  // Delivery
  status          String   // PENDING, DELIVERED, FAILED, RETRYING
  httpStatusCode  Int?
  responseBody    String?

  // Retry
  attemptCount    Int      @default(0)
  nextRetryAt     DateTime?

  createdAt       DateTime @default(now())
  deliveredAt     DateTime?
  tenantId        String

  @@index([endpointId, status])
  @@map("m13_webhook_deliveries")
}
