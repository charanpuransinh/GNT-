{
  "module": "M20",
  "version": "2.0",
  "description": "Cross-module wiring map for M20 International Trade",
  "providers": {
    "M20": {
      "hsn.service.ts": {
        "searchHSN": ["M06", "M07", "M08", "M09"],
        "validateHSN": ["M09"],
        "getHSNDetails": ["M06", "M08"]
      },
      "trade.service.ts": {
        "createExportShipment": ["M08"],
        "createImportShipment": ["M07"],
        "getTradeJob": ["M10", "M11"]
      },
      "fx.service.ts": {
        "getFXRate": ["M06", "M08", "M09", "M10"],
        "convertAmount": ["M10", "M11"]
      },
      "customs.service.ts": {
        "calculateCustomsDuty": ["M11"],
        "getCustomsRules": ["M11"]
      },
      "trade-document.service.ts": {
        "generateDocument": ["M08", "M10"],
        "getDocument": ["M10", "M11"]
      }
    }
  },
  "consumers": {
    "M20": {
      "M05": ["party.service.getParty"],
      "M06": ["product.service.getProduct"],
      "M07": ["purchase.service.getPurchaseInvoice"],
      "M08": ["sales.service.getSalesInvoice"],
      "M09": ["gst.service.calculateIGST", "gst.service.validateGSTIN"],
      "M10": ["accounting.service.createLedgerEntry"],
      "M11": ["payment.service.createPayment"],
      "M18": ["integration.service.sendViaGateway"]
    }
  },
  "events": {
    "published_by_M20": [
      "trade.export.created",
      "trade.import.created",
      "hsn.classified",
      "fx.rate.updated",
      "customs.duty.calculated"
    ],
    "subscribed_by_M20": []
  },
  "hard_boundaries": {
    "legal": [
      "M06 -> M20 hsn.service.searchHSN()",
      "M08 -> M20 trade.service.createExportShipment()",
      "M09 -> M20 hsn.service.validateHSN()"
    ],
    "illegal": [
      "M20 -> M06 product.repository.ts",
      "M20 -> M08 sales_invoice table directly",
      "M20 creating duplicate Party Master",
      "M20 creating duplicate Product Master",
      "M20 bypassing GST/HSN validation"
    ]
  }
}