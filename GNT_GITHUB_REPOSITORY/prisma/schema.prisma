  @@index([tenantId, status])
  @@map("m15_restore_jobs")
}

// ────────────────────────────────────────────────────────────
// GNT M05 — PARTY MANAGEMENT (टास्क #007)
// समीक्षक AI का तय डिज़ाइन — कोई SQL source नहीं था, ज्यों-का-त्यों लिया गया।
// Party = दुकानदार का ग्राहक/सप्लायर (company_master की कंपनी नहीं)।
// बकाया (outstanding) यहाँ store नहीं होता — M10 से गिनकर आता है।
// ────────────────────────────────────────────────────────────

model party_master {
  id             String   @id @default(uuid()) @db.Uuid
  company_id     String   @db.Uuid
  branch_id      String?  @db.Uuid
  party_type     String   @db.VarChar(10)   // customer | supplier | both
  name           String   @db.VarChar(200)
  display_name   String?  @db.VarChar(100)  // बिल में छोटा नाम
  gstin          String?  @db.VarChar(15)
  pan            String?  @db.VarChar(10)
  gst_type       String?  @db.VarChar(20)   // regular | composition | unregistered | sez | overseas
  contact_person String?  @db.VarChar(100)
  phone          String?  @db.VarChar(20)
  alt_phone      String?  @db.VarChar(20)
  email          String?  @db.VarChar(255)
  billing_address String? @db.Text
  shipping_address String? @db.Text
  city           String?  @db.VarChar(100)
  state_code     String?  @db.VarChar(2)    // GST राज्य कोड — CGST/SGST बनाम IGST यहीं से तय होता है
  pincode        String?  @db.VarChar(10)
  country        String   @default("IN") @db.VarChar(2)
  credit_limit   Decimal  @default(0) @db.Decimal(14, 2)
  credit_days    Int      @default(0)
  opening_balance Decimal @default(0) @db.Decimal(14, 2)
  opening_type   String   @default("dr") @db.VarChar(2)   // dr | cr
  notes          String?  @db.Text
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  created_by     String?  @db.Uuid
  updated_by     String?  @db.Uuid

  company_master company_master @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, gstin])
  @@index([company_id, party_type])
  @@index([company_id, name])
  @@map("party_master")
}

// ============================================================================
// M13 — SMART AUTOMATION (blueprint §7.13: automation_rule, scheduled_job, job_execution_log)
// एक ही मालिक: M13. बाक़ी modules public API से ही बात करेंगे — सीधे tables नहीं।
// ============================================================================

model AutomationRule {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  description  String?
  triggerType  String   // EVENT | SCHEDULE | MANUAL
  triggerEvent String?  // EVENT वाले rules के लिए event नाम (जैसे payment.reminder)
  triggerConfig Json?   // trigger की अपनी सेटिंग
  actions      Json     // क्रम से actions: [{type: NOTIFY|WEBHOOK|LOG, config}]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  updatedBy    String

  scheduledJobs ScheduledJob[]
  executionLogs JobExecutionLog[]

  @@index([tenantId, isActive])
  @@index([tenantId, triggerType])
  @@map("m13_automation_rules")
}

model ScheduledJob {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  name      String
  cronExpr  String   // 5 fields: minute hour day month weekday
  timezone  String   @default("UTC")
  payload   Json?
  status    String   @default("ACTIVE") // ACTIVE | PAUSED
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  executionLogs JobExecutionLog[]

  @@index([tenantId, status])
  @@index([nextRunAt])
  @@map("m13_scheduled_jobs")
}

model JobExecutionLog {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  ruleId     String?
  rule       AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  jobId      String?
  job        ScheduledJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status     String    // RUNNING | SUCCESS | FAILED
  message    String?
  metadata   Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([tenantId, startedAt])
  @@index([tenantId, jobId])
  @@map("m13_job_execution_logs")
}

// ============================================================================
// M16 — NOTIFICATION CAMPAIGN (SPEC-B: WhatsApp campaign + secure order link)
// ============================================================================

model NotificationCampaign {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  name         String
  message      String
  channel      String   @default("whatsapp") // whatsapp | sms | email
  status       String   @default("DRAFT")    // DRAFT, SENDING, COMPLETED, FAILED
  targetPartyIds Json?  // ग्राहक parties की id सूची
  orderOffer   String?  // secure order-link खोलने पर दिखने वाला ऑफ़र/संदेश
  sentCount    Int      @default(0)
  failedCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String

  @@index([companyId, status])
  @@map("m16_campaigns")
}

