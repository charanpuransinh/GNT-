  failed
}

model SecurityEvent {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  eventType   String    @map("event_type")
  severity    Severity
  description String
  metadata    Json?
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([companyId, severity, createdAt])
  @@index([eventType, createdAt])
  @@map("security_event")
}

enum Severity {
  low
  medium
  high
  critical
}

model SystemHealth {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  serviceName     String   @map("service_name")
  status          HealthStatus
  responseTimeMs  Int?     @map("response_time_ms")
  lastCheckedAt   DateTime @default(now()) @map("last_checked_at")
  errorCount      Int      @default(0) @map("error_count")

  @@index([companyId, serviceName])
  @@index([status, lastCheckedAt])
  @@map("system_health")
}

enum HealthStatus {
  healthy
  degraded
  unhealthy
  down
}

// ═══════════════════════════════════════════════════════════════
// TEAM D — M20 INTERNATIONAL TRADE
// SOURCE: team-d/M20-International-Trade/database/m20-schema.prisma
// टास्क #015: ⛔ team-d वाला hsn_master मत डालना (M09 का है) → नया customs_tariff।
// बाक़ी 4 models ज्यों-के-त्यों (relations customs_tariff की तरफ)।
// ⚠️ Step 2 के लिए customs_rule.sws_rate जोड़ा (source में नहीं था)।
// ═══════════════════════════════════════════════════════════════

model customs_tariff {
  id          String   @id @default(cuid())
  code        String   @unique // 8-digit HSN
  description String
  chapter     String   // 2-digit
  heading     String   // 4-digit
  subheading  String   // 6-digit
  tariff_item String   // 8-digit
  gst_rate    Decimal  @db.Decimal(5, 2)
  igst_rate   Decimal  @db.Decimal(5, 2)
  cess_rate   Decimal  @db.Decimal(5, 2)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  customs_rules customs_rule[]
  trade_jobs    trade_job[]

  @@index([code])
  @@index([chapter, heading])
  @@map("customs_tariff")
}

model trade_job {
  id              String    @id @default(cuid())
  company_id      String
  type            TradeType // import | export
  reference_no    String    @unique
  party_id        String
  product_id      String
  hsn_code        String
  quantity        Decimal   @db.Decimal(18, 4)
  value_fob       Decimal?  @db.Decimal(18, 4) // Free On Board
  value_cif       Decimal?  @db.Decimal(18, 4) // Cost Insurance Freight
  currency        String    @default("USD")
  fx_rate         Decimal   @db.Decimal(18, 6)
  customs_duty    Decimal?  @db.Decimal(18, 4)
  gst_amount      Decimal?  @db.Decimal(18, 4)
  status          TradeStatus @default(draft)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  completed_at    DateTime?

  hsn             customs_tariff @relation(fields: [hsn_code], references: [code])
  documents       trade_document[]

  @@index([company_id, type])
  @@index([status])
  @@index([reference_no])
  @@map("trade_job")
}

model fx_rate {
  id              String   @id @default(cuid())
  company_id      String
  base_currency   String   @default("INR")
  target_currency String
  rate            Decimal  @db.Decimal(18, 6)
  source          String   @default("manual") // manual | rbi | xe
  effective_date  DateTime @default(now())
  created_at      DateTime @default(now())

  @@unique([company_id, base_currency, target_currency, effective_date])
  @@index([company_id, target_currency])
  @@map("fx_rate")
}

model customs_rule {
  id                String   @id @default(cuid())
  company_id        String
  hsn_code          String
  bcd_rate          Decimal  @db.Decimal(5, 2) // Basic Customs Duty
  sws_rate          Decimal  @db.Decimal(5, 2) @default(10) // Social Welfare Surcharge (टास्क #015)
  acd_rate          Decimal  @db.Decimal(5, 2) // Additional Customs Duty
  sad_rate          Decimal  @db.Decimal(5, 2) // Special Additional Duty
  cvd_rate          Decimal  @db.Decimal(5, 2) // Countervailing Duty
  anti_dumping_rate Decimal  @db.Decimal(5, 2) @default(0)
  safeguard_duty    Decimal  @db.Decimal(5, 2) @default(0)
  effective_from    DateTime
  effective_to      DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  hsn               customs_tariff @relation(fields: [hsn_code], references: [code])

  @@index([company_id, hsn_code])
  @@index([effective_from])
  @@map("customs_rule")
}

model trade_document {
  id              String       @id @default(cuid())
  company_id      String
  trade_job_id    String
  document_type   DocumentType
  content_json    Json
  generated_at    DateTime     @default(now())
  status          DocumentStatus @default(generated)
  file_url        String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  trade_job       trade_job    @relation(fields: [trade_job_id], references: [id])

  @@index([trade_job_id, document_type])
  @@map("trade_document")
}

enum TradeType {
  import
  export
}

enum TradeStatus {
  draft
  submitted
  under_review
  customs_cleared
  completed
  cancelled
}

enum DocumentType {
  boe
  shipping_bill
  commercial_invoice
  packing_list
  certificate_of_origin
}

enum DocumentStatus {
  generated
  signed
  submitted
  approved
  rejected
}

// ═══════════════════════════════════════════════════════════════
// TEAM D — M17 REPORTING
// SOURCE: team-d/M17-Reporting/database/report_config.sql + report_template.sql
// टास्क #012: camelCase model नाम (code इसी से बुलाता है) + @@map।
// ═══════════════════════════════════════════════════════════════

model ReportConfig {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  name         String
  reportType   String   @map("report_type")
  filtersJson  Json     @default("{}") @map("filters_json")
  schedule     Json?
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([reportType])
  @@index([createdBy])
  @@map("report_config")

  // CHECK: report_type IN ('sales','purchase','inventory','gst','accounting','hr','executive')
}

model ReportTemplate {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  name         String
  templateType String   @map("template_type")
  layoutJson   Json     @default("{}") @map("layout_json")
  headerHtml   String?  @map("header_html")
  footerHtml   String?  @map("footer_html")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([templateType])
  @@map("report_template")

  // CHECK: template_type IN ('pdf','excel','html','csv')
}

// ────────────────────────────────────────────────────────────
// GNT M11 — PAYMENT MODULE
// Source: database/schema/M11_Payment.prisma (Team C, Session 2)
// टास्क #008: side-file से ज्यों-के-त्यों उठाए गए; @@map ज्यों-के-त्यों।
//   - PaymentReconciliationItem नया model है (code बुलाता था, side-file में नहीं था)
//   - PaymentReconciliation में items back-relation जोड़ा गया (नए model के लिए ज़रूरी)
// ────────────────────────────────────────────────────────────

model PaymentMethod {
  id              String   @id @default(cuid())
  code            String   // CASH, BANK_TRANSFER, UPI, CARD, CHEQUE, WALLET — per-tenant unique
  name            String
  description     String?
  isActive        Boolean  @default(true)
  configJson      Json?    // Provider-specific config (Stripe keys, Razorpay, etc.)

  // Provider linkage
  providerCode    String?  // stripe, razorpay, paypal, internal
  providerConfig  Json?

  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  updatedBy       String
  tenantId        String   @map("tenant_id")

  // Relations
  transactions    PaymentTransaction[]
  schedules       PaymentSchedule[]

  @@index([tenantId, isActive])
  @@unique([code, tenantId])
  @@map("m11_payment_methods")
}

model PaymentTransaction {
  id                  String   @id @default(cuid())
  transactionNumber   String   @unique // TXN-2026-000001

  // Party info (generic — can be customer, vendor, employee)
  partyType           String   // CUSTOMER, VENDOR, EMPLOYEE, SYSTEM
  partyId             String   // External ID from respective module
  partyName           String
  partyContact        String?

  // Amount
  amount              Decimal  @db.Decimal(18, 4)
  currency            String   @default("INR")
  exchangeRate        Decimal  @default(1.0) @db.Decimal(18, 6)
  baseAmount          Decimal  @db.Decimal(18, 4) // amount * exchangeRate

  // Direction
  direction           String   // IN (receipt), OUT (payment)

  // Status lifecycle
  status              String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED, REFUNDED
  statusHistory       Json[]   // [{status, at, by, reason}]

  // Method
  paymentMethodId     String
  paymentMethod       PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  // Reference linking (to invoices, bills, payroll, etc.)
  referenceType       String?  // INVOICE, BILL, PAYROLL, ORDER, JOURNAL
  referenceId         String?
  referenceNumber     String?

  // Provider tracking
  providerRef         String?  // Stripe payment_intent_id, Razorpay order_id
  providerResponse    Json?
  providerWebhookData Json?

  // Bank/Reconciliation
  bankAccountId       String?
  reconciled          Boolean  @default(false)
  reconciledAt        DateTime?
  reconciliationId    String?

  // Narration
  narration           String?
  internalNotes       String?

  // Dates
  transactionDate     DateTime
  valueDate           DateTime?
  settledAt           DateTime?

  // Audit
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String
  updatedBy           String
  tenantId            String   @map("tenant_id")

  // Relations
  refunds             Refund[]
  allocations         PaymentAllocation[]
  ledgerEntries       PaymentLedgerEntry[]

  @@index([tenantId, status])
  @@index([tenantId, transactionDate])
  @@index([partyType, partyId])
  @@index([referenceType, referenceId])
  @@index([providerRef])
  @@map("m11_payment_transactions")
}

model PaymentAllocation {
  id              String   @id @default(cuid())
  transactionId   String
  transaction     PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // What is being paid
  targetType      String   // INVOICE, BILL, ORDER, ACCOUNT
  targetId        String
  targetNumber    String?

  allocatedAmount Decimal  @db.Decimal(18, 4)

  // For partial allocations
  isFullPayment   Boolean  @default(false)

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([transactionId])
  @@index([targetType, targetId])
  @@map("m11_payment_allocations")
}

model PaymentSchedule {
  id              String   @id @default(cuid())
  scheduleNumber  String   @unique

  // Source
  sourceType      String   // INVOICE, BILL, SUBSCRIPTION, LOAN
  sourceId        String

  // Schedule details
  totalAmount     Decimal  @db.Decimal(18, 4)
  paidAmount      Decimal  @default(0) @db.Decimal(18, 4)
  pendingAmount   Decimal  @db.Decimal(18, 4)

  frequency       String?  // ONCE, WEEKLY, MONTHLY, QUARTERLY, YEARLY
  installments    Int      @default(1)

  // Dates
  startDate       DateTime
  endDate         DateTime?
  nextDueDate     DateTime?

  // Status
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED, OVERDUE

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  // Child installments
  installmentsList PaymentInstallment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@index([tenantId, status])
  @@index([sourceType, sourceId])
  @@map("m11_payment_schedules")
}

model PaymentInstallment {
  id              String   @id @default(cuid())
  scheduleId      String
  schedule        PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  installmentNo   Int
  amount          Decimal  @db.Decimal(18, 4)
  dueDate         DateTime
  paidDate        DateTime?

  status          String   @default("PENDING") // PENDING, PAID, OVERDUE, WAIVED
  transactionId   String?

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([scheduleId])
  @@map("m11_payment_installments")
}

model Refund {
  id              String   @id @default(cuid())
  refundNumber    String   @unique

  originalTxnId   String
  originalTxn     PaymentTransaction @relation(fields: [originalTxnId], references: [id])

  amount          Decimal  @db.Decimal(18, 4)
  reason          String
  status          String   @default("PENDING") // PENDING, APPROVED, PROCESSED, REJECTED

  processedAt     DateTime?
  providerRef     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@index([originalTxnId])
  @@map("m11_refunds")
}

model PaymentLedgerEntry {
  id              String   @id @default(cuid())
  transactionId   String
  transaction     PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  entryType       String   // DEBIT, CREDIT
  accountCode     String   // Chart of accounts code (from M10 Finance — PUBLIC API only)
  amount          Decimal  @db.Decimal(18, 4)

  // For double-entry
  contraAccount   String?

  fiscalYear      String
  period          String   // MM-YYYY

  postedAt        DateTime @default(now())
  tenantId        String

  @@index([transactionId])
  @@index([tenantId, fiscalYear])
  @@map("m11_payment_ledger_entries")
}

model PaymentReconciliation {
  id              String   @id @default(cuid())
  reconNumber     String   @unique

  bankAccountId   String
  statementDate   DateTime
  openingBalance  Decimal  @db.Decimal(18, 4)
  closingBalance  Decimal  @db.Decimal(18, 4)

  // Summary
  matchedCount    Int      @default(0)
  unmatchedCount  Int      @default(0)
  matchedAmount   Decimal  @default(0) @db.Decimal(18, 4)
  unmatchedAmount Decimal  @default(0) @db.Decimal(18, 4)

  status          String   @default("DRAFT") // DRAFT, IN_PROGRESS, RECONCILED, VARIANCE

  // Upload reference
  statementFileId String?

  // Items (टास्क #008 — नया relation, code `include: { items: true }` बुलाता है)
  items           PaymentReconciliationItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@map("m11_payment_reconciliations")
}

// टास्क #008 — नया model (code में prisma.reconciliationItem था, side-file में नहीं था)
// फील्ड code के असली इस्तेमाल से लिए गए हैं (reconciliation.repository.ts)
model PaymentReconciliationItem {
  id               String                @id @default(cuid())
  reconciliationId String
  reconciliation   PaymentReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  transactionId    String?
  statementDate    DateTime
  statementDesc    String
  statementAmount  Decimal               @db.Decimal(18, 4)
  statementType    String

  isMatched        Boolean               @default(false)
  matchConfidence  Decimal?              @db.Decimal(5, 2)
  varianceAmount   Decimal?              @db.Decimal(18, 4)
  resolutionNotes  String?
  resolvedBy       String?
  resolvedAt       DateTime?

  createdBy        String
  updatedBy        String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenantId         String

  @@index([reconciliationId])
  @@index([tenantId, isMatched])
  @@map("payment_reconciliation_item")
}

model BankAccount {
  id              String   @id @default(cuid())
  accountCode     String   @unique
  accountName     String
  bankName        String
  accountNumber   String   // Masked storage
  ifscCode        String?
  branch          String?

  accountType     String   // CURRENT, SAVINGS, CASH, WALLET
  currency        String   @default("INR")

  openingBalance  Decimal  @default(0) @db.Decimal(18, 4)
  currentBalance  Decimal  @default(0) @db.Decimal(18, 4)

  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)

  // For auto-sync
  syncConfig      Json?
  lastSyncedAt    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@index([tenantId, isActive])
  @@map("m11_bank_accounts")
}

// ────────────────────────────────────────────────────────────
// GNT M12 — HR MODULE
// Source: database/schema/M12_HR.prisma (Team C, Session 2)
// टास्क #008: side-file से ज्यों-के-त्यों; @@map ज्यों-के-त्यों।
//   - LeaveBalance और HREventLog नए models (code बुलाता था, side-file में नहीं थे)
//   - LeaveBalance के फील्ड code के असली इस्तेमाल से (leave.service.ts):
//     employeeId_year compound unique + annual/sick/casual/unpaid/used
//     (task के field-list में leave_type_id/entitled/balance थे — कोड उन्हें नहीं बुलाता,
//      इसलिए leaveTypeId/entitled/balance optional रखे, ज़रूरी वही जो कोड चाहता है)
// ────────────────────────────────────────────────────────────

model Employee {
  id              String   @id @default(cuid())
  employeeCode    String   @unique // EMP-2026-0001

  // Personal
  firstName       String
  lastName        String
  email           String
  phone           String?
  alternatePhone  String?
  dateOfBirth     DateTime?
  gender          String?  // MALE, FEMALE, OTHER, PREFER_NOT_TO_SAY
  bloodGroup      String?

  // Identity
  panNumber       String?
  aadhaarNumber   String?  // Encrypted at application layer
  uanNumber       String?  // Universal Account Number (PF)
  esicNumber      String?

  // Employment
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  designationId   String
  designation     Designation @relation(fields: [designationId], references: [id])

  employmentType  String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  employmentStatus String  @default("ACTIVE") // ACTIVE, PROBATION, NOTICE_PERIOD, RESIGNED, TERMINATED

  dateOfJoining   DateTime
  dateOfExit      DateTime?

  // Reporting
  reportingToId   String?
  reportingTo     Employee? @relation("EmployeeReporting", fields: [reportingToId], references: [id])
  subordinates    Employee[] @relation("EmployeeReporting")

  // Compensation (monthly)
  basicSalary     Decimal  @db.Decimal(18, 4)
  salaryStructure Json?    // Breakdown: HRA, DA, TA, etc.

  // Bank
  bankAccountName String?
  bankAccountNo   String?  // Encrypted
  bankIfsc        String?
  bankName        String?

  // Work
  shiftId         String?
  shift           Shift?   @relation(fields: [shiftId], references: [id])
  workLocation    String?

  // Documents
  documents       EmployeeDocument[]

  // Relations
  attendances     Attendance[]
  leaves          Leave[]
  payrolls        Payroll[]
  leaveBalances   LeaveBalance[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@index([tenantId, employmentStatus])
  @@index([departmentId])
  @@index([reportingToId])
  @@map("m12_employees")
}

model Department {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?

  parentId        String?
  parent          Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children        Department[] @relation("DeptHierarchy")

  costCenterCode  String?  // Links to M10 Finance
  isActive        Boolean  @default(true)

  employees       Employee[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_departments")
}

model Designation {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  level           Int      @default(1) // 1=Junior, 5=Executive
  description     String?
  isActive        Boolean  @default(true)

  employees       Employee[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_designations")
}

model EmployeeDocument {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  documentType    String   // RESUME, OFFER_LETTER, AADHAAR, PAN, CONTRACT, EXPERIENCE
  documentName    String
  fileUrl         String
  fileKey         String   // S3/Storage key
  mimeType        String
  fileSize        Int

  expiryDate      DateTime?
  isVerified      Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?

  createdAt       DateTime @default(now())
  tenantId        String

  @@index([employeeId])
  @@map("m12_employee_documents")
}

model Shift {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String

  startTime       String   // "09:00"
  endTime         String   // "18:00"
  breakDuration   Int      @default(60) // minutes

  workingDays     String[] // ["MON","TUE","WED","THU","FRI"]

  gracePeriod     Int      @default(15) // minutes
  halfDayAfter    Int      @default(240) // minutes after start

  isNightShift    Boolean  @default(false)
  isActive        Boolean  @default(true)

  employees       Employee[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_shifts")
}

model Attendance {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date

  // Punch times
  checkIn         DateTime?
  checkOut        DateTime?

  // Geo
  checkInLocation Json?    // {lat, lng, address}
  checkOutLocation Json?

  // Device
  checkInDevice   String?  // WEB, MOBILE, BIOMETRIC, MANUAL
  checkOutDevice  String?

  // Calculated
  totalHours      Decimal? @db.Decimal(4, 2)
  breakHours      Decimal? @db.Decimal(4, 2)
  workingHours    Decimal? @db.Decimal(4, 2)
  overtimeHours   Decimal? @db.Decimal(4, 2)

  // Status
  status          String   @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, ON_LEAVE, WFH, HOLIDAY, WEEKLY_OFF
  lateByMinutes   Int      @default(0)
  earlyExitMinutes Int     @default(0)

  // Remarks
  remarks         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId, status])
  @@map("m12_attendance")
}

model LeaveType {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?

  // Entitlement
  annualQuota     Decimal  @db.Decimal(5, 2) // days per year
  maxCarryForward Decimal  @default(0) @db.Decimal(5, 2)
  encashable      Boolean  @default(false)

  // Rules
  minDaysPerRequest Int    @default(1)
  maxDaysPerRequest Int?
  noticeDaysRequired Int   @default(0)

  // Pay rules
  isPaid          Boolean  @default(true)
  payPercentage   Decimal  @default(100) @db.Decimal(5, 2)

  isActive        Boolean  @default(true)

  leaves          Leave[]
  leaveBalances   LeaveBalance[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m12_leave_types")
}

model Leave {
  id              String   @id @default(cuid())
  leaveNumber     String   @unique // LEV-2026-0001

  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])

  // Dates
