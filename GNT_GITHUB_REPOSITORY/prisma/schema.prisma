// SOURCE: M04 SQL / M02 SQL canonical identity models
model company_master {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(200)
  gstin String? @unique @db.VarChar(15)
  address String? @db.Text
  phone String? @db.VarChar(20)
  email String? @db.VarChar(255)
  logo_url String? @db.Text
  primary_color String? @default("#2563EB") @db.VarChar(7)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  branch_master branch_master[]
  deployment_settings deployment_settings?
  financial_year financial_year[]
  user_master user_master[]
  @@map("company_master")
}

model branch_master {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  name String @db.VarChar(100)
  code String @db.VarChar(20)
  address String? @db.Text
  is_active Boolean @default(true)
  created_at DateTime @default(now())
  deleted_at DateTime?
  company_master company_master @relation(fields: [company_id], references: [id], onDelete: Cascade)
  @@index([company_id])
  @@map("branch_master")
}

model user_master {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  branch_id String? @db.Uuid
  name String @db.VarChar(100)
  email String @db.VarChar(100)
  username String @db.VarChar(50)
  password_hash String @db.VarChar(255)
  pin_hash String? @db.VarChar(255)
  avatar String? @db.VarChar(255)
  is_active Boolean @default(true)
  two_factor_enabled Boolean @default(false)
  failed_login_attempts Int @default(0)
  locked_until DateTime?
  last_login_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?
  user_role user_role[]
  device_registry device_registry[]
  active_session active_session[]
  company_master company_master @relation(fields: [company_id], references: [id], onDelete: Cascade)
  @@unique([company_id, username])
  @@unique([company_id, email])
  @@map("user_master")
}

model role_master {
  id String @id @default(uuid()) @db.Uuid
  company_id String @db.Uuid
  name String @db.VarChar(50)
  description String? @db.VarChar(200)
  is_system_role Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_role user_role[]
  role_permission role_permission[]
  @@unique([company_id, name])
  @@map("role_master")
}

model permission_master {
  id String @id @default(uuid()) @db.Uuid
  module String @db.VarChar(10)
  action String @db.VarChar(20)
  resource String @db.VarChar(50)
  description String? @db.VarChar(200)
  created_at DateTime @default(now())
  role_permission role_permission[]
  @@unique([module, action, resource])
  @@map("permission_master")
}

model user_role {
  id String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  role_id String @db.Uuid
  assigned_at DateTime @default(now())
  assigned_by String? @db.Uuid
  user_master user_master @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role_master role_master @relation(fields: [role_id], references: [id], onDelete: Cascade)
  @@unique([user_id, role_id])
  @@map("user_role")
}

model role_permission {
  id String @id @default(uuid()) @db.Uuid
  role_id String @db.Uuid
  permission_id String @db.Uuid
  role_master role_master @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission_master permission_master @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  @@unique([role_id, permission_id])
  @@map("role_permission")
}

// ═══════════════════════════════════════════════════════════════
// TEAM A — M03 DEVICE & PLATFORM + M04 FINANCIAL YEAR
// SOURCE (सच = source of truth):
//   - database/schema/m03/schema.sql  (device_registry, active_session, deployment_settings)
//   - database/schema/m04/m04_schema.sql (financial_year)
// टास्क #003 में समीक्षक AI की लिखित अनुमति से जोड़े गए।
// ═══════════════════════════════════════════════════════════════

model device_registry {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  device_name  String   @db.VarChar(100)
  model        String   @db.VarChar(100)
  platform     String   @db.VarChar(20)
  os_version   String   @db.VarChar(50)
  app_version  String   @db.VarChar(20)
  push_token   String?  @db.VarChar(255)
  is_trusted   Boolean  @default(false)
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user_master    user_master      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  active_session active_session[]

  @@unique([user_id, device_name])
  @@index([user_id])
  @@index([platform])
  @@map("device_registry")

  // CHECK: platform IN ('ios','android','windows','macos','linux','web') — SQL का CHECK Prisma में नहीं लिख सकते, app layer में validate होगा
}

model active_session {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  device_id      String?   @db.Uuid
  device_name    String?   @db.VarChar(100)
  platform       String?   @db.VarChar(20)
  ip_address     String    @db.Inet
  location       String?   @db.VarChar(100)
  user_agent     String?   @db.Text
  status         String    @default("active") @db.VarChar(20)
  created_at     DateTime  @default(now())
  last_active_at DateTime  @default(now())
  expires_at     DateTime
  user_master    user_master      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device_registry device_registry? @relation(fields: [device_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([expires_at])
  @@index([status])
  @@map("active_session")

  // CHECK: status IN ('active','idle','expired') — app layer में validate होगा
  // CHECK: valid_expiry (expires_at > created_at) — app layer में validate होगा
  // SQL का partial index (status WHERE active) Prisma में नहीं — सामान्य @@index([status]) रखा है
}

model deployment_settings {
  id                    String   @id @default(uuid()) @db.Uuid
  company_id            String   @unique @db.Uuid
  auto_update           Boolean  @default(false)
  update_notifications  Boolean  @default(true)
  session_timeout       Int      @default(30)
  force_single_session  Boolean  @default(false)
  offline_sync          Boolean  @default(true)
  sync_interval         Int      @default(15)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  company_master company_master @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("deployment_settings")

  // CHECK: session_timeout BETWEEN 5 AND 120 — app layer में validate होगा
  // CHECK: sync_interval BETWEEN 1 AND 60 — app layer में validate होगा
  // SQL का अलग INDEX (company_id) यहाँ ज़रूरी नहीं — @unique(company_id) खुद index बनाता है
}

model financial_year {
  id         String   @id @default(uuid()) @db.Uuid
  company_id String   @db.Uuid
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  prefix     String   @db.VarChar(10)
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())
  company_master company_master @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([is_active])
  @@map("financial_year")

  // EXCLUDE fy_no_overlap (gist/daterange) — Prisma में नहीं लिख सकते; raw SQL migration में जोड़ना होगा (टास्क में अलग से आएगा)
}

// ═══════════════════════════════════════════════════════════════
// TEAM D — M18 EXTERNAL INTEGRATION
// SOURCE (सच = source of truth): team-d/M18-External-Integration/database/m18-schema.prisma
// टास्क #013 में जोड़े गए (ज्यों-के-त्यों, @@map सहित) — कोई column न जोड़ा, न हटाया।
// ═══════════════════════════════════════════════════════════════

model integration_config {
  id           String   @id @default(uuid())
  company_id   String   @db.Uuid
  provider     String   @db.VarChar(100)
  type         String   @db.VarChar(50) // sms | whatsapp | payment | gstn | e_invoice | e_way_bill
  config_json  Json     @default("{}")
  status       String   @default("pending") @db.VarChar(50) // active | inactive | error | pending | degraded
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  @@index([company_id, type])
  @@index([company_id, is_active])
  @@index([provider])
  @@map("integration_config")
}

model api_key_registry {
  id           String    @id @default(uuid())
  company_id   String    @db.Uuid
  name         String    @db.VarChar(100)
  key_hash     String    @unique @db.VarChar(64) // SHA-256
  permissions  String[]  @default([])
  expires_at   DateTime? @db.Timestamptz(6)
  created_by   String    @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  @@index([company_id])
  @@index([expires_at])
  @@map("api_key_registry")
}

model webhook_log {
  id             String    @id @default(uuid())
  provider       String    @db.VarChar(100)
  event_id       String?   @db.VarChar(255)
  payload        Json      @default("{}")
  headers        Json      @default("{}")
  status         String    @default("received") @db.VarChar(50) // received | validated | processed | failed | retrying
  processed_at   DateTime? @db.Timestamptz(6)
  error_message  String?   @db.Text
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([provider, event_id])
  @@index([provider, created_at])
  @@index([status])
  @@index([created_at])
  @@map("webhook_log")
}

// ═══════════════════════════════════════════════════════════════
// TEAM D — M16 NOTIFICATION ENGINE
// SOURCE: team-d/M16-Notification-Engine/database/notification_master.sql + notification_delivery_log.sql
// टास्क #011: camelCase model नाम (code इसी से बुलाता है) + @@map से snake_case table/columns।
// ⚠️ Step 3 के लिए to_address column जोड़ा गया (source SQL में नहीं था — reviewer के फैसले का इंतज़ार)।
// ═══════════════════════════════════════════════════════════════

model NotificationMaster {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  companyId  String   @map("company_id")
  title      String
  message    String
  type       String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  priority   String   @default("normal")
  status     String   @default("pending")
  toAddress  String?  @map("to_address")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  deliveryLogs NotificationDeliveryLog[]

  @@index([userId, companyId])
  @@index([status])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("notification_master")

  // CHECK: type IN ('in_app','whatsapp','sms','email') — app layer में validate होगा
  // CHECK: entity_type IN ('sales_invoice','purchase_invoice','payment','stock','gst_return','employee_salary','general')
  // CHECK: priority IN ('low','normal','high','urgent') · status IN ('pending','sent','delivered','failed','read')
}

model NotificationDeliveryLog {
  id               String   @id @default(uuid())
  notificationId   String   @map("notification_id")
  channel          String
  status           String
  providerResponse String?  @map("provider_response")
  attemptedAt      DateTime @default(now()) @map("attempted_at")
  deliveredAt      DateTime? @map("delivered_at")
  failedAt         DateTime? @map("failed_at")
  errorMessage     String?  @map("error_message")

  notification NotificationMaster @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel, status])
  @@map("notification_delivery_log")

  // CHECK: channel IN ('in_app','whatsapp','sms','email') · status IN ('sent','delivered','failed')
}

