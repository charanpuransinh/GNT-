enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  converted
}

enum OrderStatus {
  draft
  confirmed
  partial
  delivered
  cancelled
}

enum InvoiceStatus {
  draft
  approved
  posted
  paid
  cancelled
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum ReturnStatus {
  draft
  approved
  posted
}

enum ChallanStatus {
