// ────────────────────────────────────────────────────────────
// GNT M14 — IMPORT/EXPORT MODULE
// Source: database/schema/M14_ImportExport.prisma (Team C, Session 2)
// टास्क #008: सातों models ज्यों-के-त्यों; @@map ज्यों-के-त्यों।
//   कोड में prisma.importTemplate था — ImportMapping ही वही चीज़ है (rename code में होगा)।
// ────────────────────────────────────────────────────────────

model ImportJob {
  id              String   @id @default(cuid())
  jobNumber       String   @unique // IMP-2026-000001

  name            String
  description     String?

  // Target
  targetModule    String   // M05_ITEM, M06_PARTY, M07_SALE, M08_PURCHASE, M12_EMPLOYEE
  targetEntity    String   // ITEM, CUSTOMER, SUPPLIER, INVOICE, EMPLOYEE

  // Source file
  fileName        String
  fileUrl         String
  fileKey         String
  fileSize        Int
  fileType        String   // CSV, XLSX, JSON, XML

  // Mapping
  mappingId       String?
  mapping         ImportMapping? @relation(fields: [mappingId], references: [id])
  columnMapping   Json?    // { "A": "itemCode", "B": "itemName" }

  // Processing
  totalRows       Int      @default(0)
  processedRows   Int      @default(0)
  successRows     Int      @default(0)
  failedRows      Int      @default(0)
  skippedRows     Int      @default(0)

  // Status
  status          String   @default("QUEUED") // QUEUED, VALIDATING, PROCESSING, COMPLETED, FAILED, CANCELLED

  // Validation
  validationReport Json?   // {errors: [], warnings: []}

  // Strategy
  importStrategy  String   @default("UPSERT") // INSERT, UPDATE, UPSERT
  duplicateHandling String @default("SKIP") // SKIP, UPDATE, FAIL

  // Results
  resultFileUrl   String?  // Download link for failed rows
  resultFileKey   String?

  // Schedule
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  // Error log
  errorLog        ImportErrorLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  tenantId        String

  @@index([tenantId, status])
  @@index([targetModule, targetEntity])
  @@map("m14_import_jobs")
}

model ImportMapping {
  id              String   @id @default(cuid())
  name            String
  description     String?

  targetModule    String
  targetEntity    String

  // Column mappings
  mappings        Json[]   // [{sourceColumn, targetField, transform, isRequired, defaultValue}]

  // Validation rules
  validationRules Json[]   // [{field, rule, params, errorMessage}]

  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)

  importJobs      ImportJob[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m14_import_mappings")
}

model ImportErrorLog {
  id              String   @id @default(cuid())
  importJobId     String
  importJob       ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  rowNumber       Int
  rowData         Json     // The raw row data

  errorType       String   // VALIDATION, DUPLICATE, SYSTEM, PERMISSION
  errorField      String?
  errorMessage    String
  errorCode       String?

  // Resolution
  isResolved      Boolean  @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?
  resolution      String?

  tenantId        String

  @@index([importJobId])
  @@map("m14_import_error_logs")
}

model ExportJob {
  id              String   @id @default(cuid())
  jobNumber       String   @unique // EXP-2026-000001

  name            String
  description     String?

  // Source
  sourceModule    String
  sourceEntity    String

  // Filter criteria
  filters         Json?    // {dateFrom, dateTo, status, departmentId}

  // Output
  format          String   // CSV, XLSX, PDF, JSON, XML
  templateId      String?
  template        ExportTemplate? @relation(fields: [templateId], references: [id])

  // Columns to export
  columns         Json[]   // [{field, header, width, format}]

  // Status
  status          String   @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED

  // Results
  totalRecords    Int?
  fileUrl         String?
  fileKey         String?
  fileSize        Int?
  expiresAt       DateTime?

  // Schedule
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  // For recurring exports
  isRecurring     Boolean  @default(false)
  cronExpression  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  tenantId        String

  @@index([tenantId, status])
  @@map("m14_export_jobs")
}

model ExportTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?

  sourceModule    String
  sourceEntity    String

  // Template config
  format          String   // CSV, XLSX, PDF
  columns         Json[]   // [{field, header, width, format, formula}]

  // Styling (for PDF/Excel)
  headerStyle     Json?
  rowStyle        Json?
  footerConfig    Json?

  // Filters (default)
  defaultFilters  Json?

  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)

  exportJobs      ExportJob[]

  createdAt       DateTime @default(now())
  tenantId        String

  @@map("m14_export_templates")
}

model DataTransform {
  id              String   @id @default(cuid())
  name            String
  description     String?

  // Transform type
  transformType   String   // FIELD_MAP, CONCATENATE, SPLIT, CALCULATE, LOOKUP, CONDITIONAL

  // Config
  sourceFields    String[]
  targetField     String
  transformConfig Json     // {delimiter, formula, lookupTable, conditions}

