    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@testing-library/react": "^16.3.0",
    "supertest": "^7.1.4",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "prisma": "^6.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@tanstack/react-query": "^5.85.0",
