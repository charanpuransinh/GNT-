// ── Import Jobs Table ──
model ImportJob {
  id                String        @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  entityType        String        // leads, contacts, products, etc.
  fileFormat        String        // csv, excel, json, xml
  fileName          String
  fileSize          Int
  fileUrl           String
  status            String        @default("pending") // pending, validating, processing, completed, failed, partial
  mapping           Json          // FieldMapping[]
  mappingStrategy   String        @default("auto") // auto, manual, template
  validationRules   Json          // ValidationRule[]
  totalRows         Int           @default(0)
  processedRows     Int           @default(0)
  successRows       Int           @default(0)
  failedRows        Int           @default(0)
  skippedRows       Int           @default(0)
  errors            Json          // ImportError[]
  dryRun            Boolean       @default(false)
  createdBy         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?

  @@index([tenantId, status])
  @@index([tenantId, entityType])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("import_jobs")
}

// ── Export Jobs Table ──
model ExportJob {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  entityType      String
  fileFormat      String
  status          String    @default("pending") // pending, processing, completed, failed
  filters         Json      @default("{}")
  selectedFields  Json      // string[]
  sortBy          String?
  sortOrder       String    @default("asc")
  totalRows       Int       @default(0)
  fileUrl         String?
  fileSize        Int?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?
  expiresAt       DateTime?

  @@index([tenantId, status])
  @@index([tenantId, entityType])
  @@index([tenantId, createdAt])
  @@index([expiresAt])
  @@map("export_jobs")
}

// ── Import Templates Table ──
model ImportTemplate {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  entityType        String
  fileFormat        String
  mapping           Json      // FieldMapping[]
  validationRules   Json      // ValidationRule[]
  sampleFileUrl     String?
  isDefault         Boolean   @default(false)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, entityType, isDefault])
  @@index([tenantId, entityType])
  @@map("import_templates")
}

// ── Export Templates Table ──
model ExportTemplate {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  entityType      String
  fileFormat      String
  selectedFields  Json      // string[]
  filters         Json      @default("{}")
  sortBy          String?
  sortOrder       String    @default("asc")
  isDefault       Boolean   @default(false)
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, entityType, isDefault])
  @@index([tenantId, entityType])
  @@map("export_templates")
}

// ── Import History / Audit ──
model ImportHistory {
  id          String   @id @default(cuid())
  tenantId    String
  jobId       String
  entityType  String
  operation   String   // create, update, upsert
  recordId    String?
  rowNumber   Int
  status      String   // success, failed, skipped
  error       String?
  rawData     Json
  createdAt   DateTime @default(now())

  @@index([tenantId, jobId])
  @@index([tenantId, entityType])
  @@index([jobId, status])
  @@map("import_history")
}
