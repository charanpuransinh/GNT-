model CompanySubscription {
  id                String             @id @default(cuid())
  companyId         String             @map("company_id")
  planId            String
  status            String             @default("ACTIVE")
  dunningStatus     String             @default("NONE")
  currentPeriodEnd  DateTime           @map("period_end")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  plan              SubscriptionPlan   @relation(fields: [planId], references: [id])
  invoices          SubscriptionInvoice[]

  @@map("m22_company_subscriptions")
}

model SubscriptionInvoice {
  id             String             @id @default(cuid())
  companyId      String             @map("company_id")
  subscriptionId String
  subscription   CompanySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planId         String
  amount         Decimal            @db.Decimal(10, 2)
  billingCycle   String             @default("MONTHLY")
  status         String             @default("PENDING")
  periodStart    DateTime
  periodEnd      DateTime
  
  // Dunning specific fields
  attemptNumber  Int                @default(1)
  errorMessage   String?            @db.VarChar(500)

  createdAt      DateTime           @default(now())

  @@unique([subscriptionId, attemptNumber]) // Prevents concurrent duplicate attempts
  @@index([companyId, status])
  @@map("m22_subscription_invoices")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("INR")
  interval    String
  features    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions CompanySubscription[]
  
  @@map("m22_subscription_plans")
}
